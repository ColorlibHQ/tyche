			"fontSizes": [
				{
					"name": "Tiny",
					"slug": "tiny",
					"size": "0.75rem"
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.125rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.25rem"
					}
				},
				{
					"name": "X Large",
					"slug": "x-large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.3125rem",
						"max": "1.625rem"
					}
				},
				{
					"name": "XX Large",
					"slug": "xx-large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.625rem"
					}
				},
				{
					"name": "Huge",
					"slug": "huge",
					"size": "3.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4rem"
					}
				},
				{
					"name": "Colossal",
					"slug": "colossal",
					"size": "5.5rem",
					"fluid": {
						"min": "3.25rem",
						"max": "6.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "10",
					"slug": "10",
					"size": "0.25rem"
				},
				{
					"name": "20",
					"slug": "20",
					"size": "0.5rem"
				},
				{
					"name": "30",
					"slug": "30",
					"size": "1rem"
				},
				{
					"name": "40",
					"slug": "40",
					"size": "1.5rem"
				},
				{
					"name": "50",
					"slug": "50",
					"size": "clamp(1.75rem, 3vw, 2.5rem)"
				},
				{
					"name": "60",
					"slug": "60",
					"size": "clamp(2.5rem, 5vw, 4rem)"
				},
				{
					"name": "70",
					"slug": "70",
					"size": "clamp(3.5rem, 8vw, 6rem)"
				},
				{
					"name": "80",
					"slug": "80",
					"size": "clamp(4.5rem, 11vw, 8.5rem)"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft",
					"slug": "soft",
					"shadow": "0 1px 2px rgba(20, 16, 12, 0.06), 0 4px 16px rgba(20, 16, 12, 0.06)"
				},
				{
					"name": "Lifted",
					"slug": "lifted",
					"shadow": "0 12px 40px rgba(20, 16, 12, 0.14)"
				}
			]
		},
		"custom": {
			"radius": {
				"small": "4px",
				"medium": "10px",
				"large": "18px",
				"pill": "999px"
			},
			"media": {
				"radius": "6px",
				"ratio": "4/5"
			},
			"header": {
				"height": "72px"
			},
			"transition": "180ms cubic-bezier(0.2, 0, 0, 1)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--figtree)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--instrument-serif)",
					"fontWeight": "400",
					"lineHeight": "1.08",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--figtree)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--figtree)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-deep)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--on-primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--figtree)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.2"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"bottom": "0.95rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-deep)",
						"text": "var(--wp--preset--color--on-primary)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--contrast)",
